      <Server2019>
        <Execute>1</Execute>
        <Physical>1</Physical>
        <Virtual>1</Virtual>
      </Server2019>
    </OS>
    <Registry>
      <Hive>HKLM</Hive>
      <Name>LongPathsEnabled</Name>
      <Path>SYSTEM\CurrentControlSet\Control\FileSystem</Path>
      <Action>SetValue</Action>
      <Value>1</Value>
      <Type>DWord</Type>
    </Registry>
