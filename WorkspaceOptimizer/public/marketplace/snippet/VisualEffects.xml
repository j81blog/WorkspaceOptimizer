  <Item>
    <Name>Disable Aero Peek</Name>
    <Description>Disables the Aero Peek feature, which allows you to preview the desktop by hovering over the 'Show desktop' button.</Description>
    <Type>Registry</Type>
    <Category>Visual Effects</Category>
    <Order>100</Order>
    <OS>
      <Windows11>
        <Execute>1</Execute>
        <Physical>1</Physical>
        <Virtual>1</Virtual>
      </Windows11>
      <Windows10>
        <Execute>1</Execute>
        <Physical>1</Physical>
        <Virtual>1</Virtual>
      </Windows10>
      <Server2025>
        <Execute>1</Execute>
        <Physical>1</Physical>
        <Virtual>1</Virtual>
      </Server2025>
      <Server2022>
        <Execute>1</Execute>
        <Physical>1</Physical>
        <Virtual>1</Virtual>
      </Server2022>
      <Server2019>
        <Execute>1</Execute>
        <Physical>1</Physical>
        <Virtual>1</Virtual>
      </Server2019>
    </OS>
    <Registry>
      <Hive>HKLM</Hive>
      <Name>DefaultValue</Name>
      <Path>SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\VisualEffects\DWMAeroPeekEnabled</Path>
      <Action>SetValue</Action>
      <Value>0</Value>
      <Type>DWord</Type>
    </Registry>
  </Item>
