{
  "name": "workspace-optimizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/validate-catalog.mjs",
    "build": "vue-tsc && vite build",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "catalog:sync": "node scripts/sync-catalog.mjs",
    "catalog:check": "node scripts/sync-catalog.mjs --check",
    "review:submission": "node scripts/review-submission.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@primeuix/themes": "^2.0.3",
    "codemirror": "^6.0.2",
    "pdfmake": "^0.3.11",
    "primevue": "^4.5.5",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@types/pdfmake": "^0.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.13"
  }
}
